# ============================================
# Brasaland — Variables de Entorno
# Copiar a .env y ajustar credenciales
# ============================================

# --- Base de Datos ---
# PostgreSQL (producción, descomentar y ajustar)
DATABASE_URL=postgresql://brasaland_user:brasaland_pass@db:5432/brasaland
# SQLite (desarrollo local sin Docker)
# DATABASE_URL=sqlite:///./data/brasaland.db

# --- Backend API ---
API_PORT=8000
API_HOST=0.0.0.0

# --- Frontends ---
WEB_PORT=3000
BACKOFFICE_PORT=3001

# --- Comunicación entre servicios (Docker) ---
BACKEND_URL=http://services:8000

# --- Entorno ---
NODE_ENV=production
# NODE_ENV=development

# --- Clave secreta (cambiar en produccion) ---
SECRET_KEY=change-me-in-production